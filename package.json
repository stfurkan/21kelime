{
	"name": "21kelime",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/check-client-bundle.mjs",
		"build:mobile": "BUILD_TARGET=mobile vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"build:words": "node scripts/build-words.ts",
		"test:e2e": "node scripts/e2e-gameplay.ts && node scripts/e2e-result.ts"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.5.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^24.13.3",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"playwright-core": "^1.63.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">=22"
	},
	"dependencies": {
		"@capacitor-community/in-app-review": "^8.0.0",
		"@capacitor/android": "^8.5.1",
		"@capacitor/app": "^8.1.1",
		"@capacitor/browser": "^8.0.4",
		"@capacitor/core": "^8.5.1",
		"@capacitor/filesystem": "^8.1.3",
		"@capacitor/haptics": "^8.0.2",
		"@capacitor/ios": "^8.5.1",
		"@capacitor/local-notifications": "^8.3.1",
		"@capacitor/share": "^8.0.1",
		"@capacitor/status-bar": "^8.0.3"
	},
	"allowScripts": {
		"sharp@0.34.5": true,
		"sharp@0.32.6": true
	}
}
